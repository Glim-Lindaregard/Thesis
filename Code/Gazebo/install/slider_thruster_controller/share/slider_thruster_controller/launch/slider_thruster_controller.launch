<launch>
    
    <arg name="point_to_point" default="True"/>
    <arg name="pos_x" default="1.0"/>
    <arg name="pos_y" default="0.5"/>
    <arg name="tau" default="0.0"/>
    <arg name="output_verbose" default="1"/>

    <node pkg="slider_thruster_controller" exec="pwm_publisher" name="pwm_publisher"/>
    <node pkg="slider_thruster_controller" exec="pid_controller" name="pid_controller">
        <param name="verbose"  value="$(var output_verbose)"/>
        <param name="point_to_point"  value="$(var point_to_point)"/>
        <param name="target_x"  value="$(var pos_x)"/>
        <param name="target_y"  value="$(var pos_y)"/>
        <param name="target_tau"  value="$(var tau)"/>
    </node> 
</launch>